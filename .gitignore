# ==============================================================================
# FanPulse AI — Root .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.swp
*.swo
*~
*.iml
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
supabase/.env
supabase/.env.*
!supabase/.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
secrets/
credentials.json
client_secrets.json

# Node.js / Frontend Dependencies & Builds
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.cache/
frontend/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java / Maven Dependencies & Builds
backend/target/
**/target/
*.class
*.jar
*.war
*.ear
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.jar

# Testing & Coverage
coverage/
.nyc_output/
*.exec
target/site/jacoco/
backend/target/site/jacoco/

# Persistent Local Database Storage
postgres_data/
*.sqlite
*.sqlite3
*.db

# Supabase Local CLI & Secrets
supabase/.temp/
supabase/.branches/
supabase/.env.local
supabase/.env.*.local

# Logs & Temporary Files
logs/
*.log
tmp/
temp/

