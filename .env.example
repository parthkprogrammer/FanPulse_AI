# ==============================================================================
# FanPulse AI — Root Environment Variables Overview
# ==============================================================================
# FanPulse AI is architected as:
# 1. Frontend: React 18 SPA (Vite) -> See frontend/.env.example
# 2. Backend & DB: Supabase (PostgreSQL, Auth, Edge Functions) -> See supabase/.env.example
#
# QUICK START:
# - Frontend:
#     cp frontend/.env.example frontend/.env.development
# - Supabase / Edge Functions:
#     cp supabase/.env.example supabase/.env.local
#
# CRITICAL SECURITY RULES:
# - NEVER commit any .env, .env.*, or secret files to Git.
# - NEVER put SUPABASE_SERVICE_ROLE_KEY or GEMINI_API_KEY into frontend environment files.
# ==============================================================================

# Frontend Variables (Vite)
VITE_APP_NAME=FanPulse AI
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=https://your-project-id.supabase.co/functions/v1

# Supabase Server-Side Secrets (Configured via `supabase secrets set`)
# SUPABASE_SERVICE_ROLE_KEY=...
# GEMINI_API_KEY=...
# CRICKET_DATA_API_KEY=...
