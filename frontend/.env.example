# ==============================================================================
# FanPulse AI — Frontend Environment Variables Template (Vite SPA)
# ==============================================================================
# IMPORTANT: Only variables prefixed with VITE_ are exposed to the client bundle.
#
# CRITICAL SECURITY RULE:
# NEVER place SUPABASE_SERVICE_ROLE_KEY, GEMINI_API_KEY, database passwords,
# or cricket provider secret keys in this file or any frontend environment file.
# Client-side bundles can be inspected by any browser user.
# ==============================================================================

# Application Display Name
VITE_APP_NAME=FanPulse AI

# Supabase Public Endpoint (Matches your Supabase Cloud or Local Studio URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (Safe for browser / client-side queries with RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Edge Functions Base URL (Gateway for backend computations & AI queries)
VITE_API_BASE_URL=https://your-project-id.supabase.co/functions/v1
