# ==============================================================================
# FanPulse AI — Frontend Local Supabase Development Environment (.env.local)
# ==============================================================================
# Copy this file to `frontend/.env.local` when running a local Supabase CLI stack:
#   cp frontend/.env.local.example frontend/.env.local
#
# NOTE: .env.local takes precedence over .env.development in Vite and is git-ignored.
# ==============================================================================

# Local Application Name
VITE_APP_NAME=FanPulse AI (Local Supabase)

# Local Supabase Kong API Gateway (Port 54321 from supabase/config.toml)
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Local Supabase Anon Key (Obtained from running `npx supabase status`)
# Replace with the actual Anon key output by `npx supabase status` or `npx supabase start`
VITE_SUPABASE_ANON_KEY=eyJh...local-anon-key-from-supabase-status

# Local Supabase Edge Functions Gateway
VITE_API_BASE_URL=http://127.0.0.1:54321/functions/v1
