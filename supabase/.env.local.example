# ==============================================================================
# FanPulse AI — Local Supabase Edge Functions Environment (.env.local)
# ==============================================================================
# Copy this file to `supabase/.env.local` for local Edge Function serving:
#   cp supabase/.env.local.example supabase/.env.local
#
# Used with:
#   npx supabase functions serve --env-file ./supabase/.env.local
#
# NOTE: This file is ignored by Git. Do NOT commit real production secrets.
# ==============================================================================

# Runtime Environment
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local Supabase Endpoints (Defaults from supabase/config.toml)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key-from-supabase-status

# PostgreSQL Direct Local Connection (Port 54322 from supabase/config.toml)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Google Gemini API Key (Server-side for AI Assistant Edge Function)
# Optional in local dev: if omitted, AI Assistant falls back to grounded telemetry context
GEMINI_API_KEY=your-gemini-api-key-here

# Cricket Telemetry Data API Key (Server-side for Cricket Data Sync)
# Optional in local dev: if omitted, system falls back to Grounded Sample Provider
CRICKET_DATA_API_KEY=your-cricket-api-key-here
CRICKET_DATA_API_BASE_URL=https://api.cricapi.com/v1

