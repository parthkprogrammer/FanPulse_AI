# ==============================================================================
# FanPulse AI — Supabase Backend & Edge Functions Environment Template
# ==============================================================================
# NOTE: Do NOT place real secrets in this example file.
#
# For Local Development: Copy to supabase/.env.local (ignored by Git).
# For Production: Deploy secrets securely using Supabase CLI:
#   npx supabase secrets set KEY=VALUE --project-ref <your-project-id>
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Metadata (Used by Supabase CLI)
# ------------------------------------------------------------------------------
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_ACCESS_TOKEN=your-personal-access-token-for-cli

# ------------------------------------------------------------------------------
# 2. PostgreSQL Direct Database Connection (Port 5432 - DDL, Migrations, Admin)
# ------------------------------------------------------------------------------
POSTGRES_HOST=db.your-project-id.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-database-password
DATABASE_URL=postgresql://postgres:your-secure-database-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. PostgreSQL Transaction Pooler (Port 6543 - PgBouncer / Supavisor)
# ------------------------------------------------------------------------------
DATABASE_POOLER_URL=postgresql://postgres.your-project-id:your-secure-database-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# ------------------------------------------------------------------------------
# 4. Public API Configuration (Shared with Frontend)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 5. Server-Side Secrets (RESTRICTED: Supabase Edge Functions & Vault ONLY)
# Never expose these keys to the frontend React bundle or client-side code.
# ------------------------------------------------------------------------------
# Privileged service role key (bypasses RLS for deterministic fantasy calculations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-frontend

# Google Gemini API Key (Used server-side by Edge Function for grounded explanations)
GEMINI_API_KEY=your-gemini-api-key-for-ai-edge-functions

# Future Cricket Telemetry Data API Key (Phase 2 integration)
CRICKET_DATA_API_KEY=your-cricket-provider-api-key-here
CRICKET_DATA_API_BASE_URL=https://api.cricapi.com/v1

# ------------------------------------------------------------------------------
# 6. Edge Function Runtime Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,https://fanpulse-ai.vercel.app
