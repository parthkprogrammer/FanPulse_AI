# ==============================================================================
# FanPulse AI — Supabase Database & Environment Configuration Template
# NOTE: Do NOT put real passwords or secret keys in this file.
# Copy to .env.local for local development or set in Supabase Dashboard for production.
# ==============================================================================

# Supabase Project Metadata
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_ACCESS_TOKEN=your-personal-access-token-for-cli

# Direct PostgreSQL Database Connection (Port 5432 - for DDL, Migrations, Admin)
POSTGRES_HOST=db.your-project-id.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-database-password
DATABASE_URL=postgresql://postgres:your-secure-database-password@db.your-project-id.supabase.co:5432/postgres

# Connection Pooler (PgBouncer Port 6543 - for high-throughput Edge Functions & serverless)
DATABASE_POOLER_URL=postgresql://postgres.your-project-id:your-secure-database-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Public Client Configuration (Safe for frontend .env)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-Side Secrets (RESTRICTED: Supabase Edge Functions & Vault ONLY)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-frontend
GEMINI_API_KEY=your-gemini-api-key-for-ai-edge-functions
